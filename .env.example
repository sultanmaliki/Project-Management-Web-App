# Used by `docker compose`. Copy to `.env` (git-ignored) and fill in the values.
# For local development without Docker see backend/.env.example instead.

# Database password. Keep it URL-safe (letters, digits, - and _) because it is embedded in a URL.
POSTGRES_PASSWORD=

# Signs login tokens. Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The first administrator, created on startup only if no admin exists yet. Change the password after
# first login (avatar menu -> Change password).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Set to false to stop people creating accounts from the login screen (admins can still add users).
ALLOW_SIGNUP=true

# Optional: enables the AI user-story generator. Get a key at https://console.groq.com
GROQ_API_KEY=
