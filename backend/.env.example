# Copy to `.env` (never commit the real file). Every value can also be set as a real environment variable.

# development | test | production. In production SECRET_KEY is mandatory and API docs are disabled.
ENVIRONMENT=development

# SQLite works out of the box; use PostgreSQL for anything real, e.g.
# DATABASE_URL=postgresql://projectflow:change-me@localhost:5432/projectflow
DATABASE_URL=sqlite:///./projectflow.db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Let anyone register a (developer-role) account from the login screen.
ALLOW_SIGNUP=true

# Creates this administrator on startup if the database has no admin yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# JSON list of browser origins allowed to call the API (only needed if the frontend
# is served from a different origin than the API).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI user-story generator (optional). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
